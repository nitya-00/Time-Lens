generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String?      @unique
  displayName  String       @default("My profile")
  createdAt    DateTime     @default(now())
  passwordHash String?
  challenges   Challenge[]
  checkIns     CheckIn[]
  dailyLogs    DailyLog[]
  experiments  Experiment[]
  goals        Goal[]
  reminders    Reminder[]
}

model Category {
  id           String        @id @default(cuid())
  name         String        @unique
  group        CategoryGroup
  createdAt    DateTime      @default(now())
  hourlyBlocks HourlyBlock[]
}

model DailyLog {
  id           String        @id @default(cuid())
  userId       String
  date         DateTime      @db.Date
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hourlyBlocks HourlyBlock[]

  @@unique([userId, date])
  @@index([date])
}

model HourlyBlock {
  id               String          @id @default(cuid())
  dailyLogId       String
  hourIndex        Int
  categoryId       String?
  activity         String?
  plannedTask      String?
  distraction      DistractionType @default(NONE)
  missedPlanReason String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  category         Category?       @relation(fields: [categoryId], references: [id])
  dailyLog         DailyLog        @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@unique([dailyLogId, hourIndex])
  @@index([categoryId])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  type        GoalType  @default(GENERAL)
  title       String
  targetValue String?
  dueDate     DateTime? @db.Date
  progress    Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns    GoalCheckIn[]
}

model GoalCheckIn {
  id        String   @id @default(cuid())
  goalId    String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, date])
  @@index([date])
}

model Challenge {
  id         String         @id @default(cuid())
  userId     String
  title      String         @default("100 Days Challenge")
  targetDays Int            @default(100)
  startDate  DateTime       @db.Date
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  days       ChallengeDay[]
}

model ChallengeDay {
  id          String            @id @default(cuid())
  challengeId String
  dayNumber   Int
  date        DateTime          @db.Date
  description String
  category    ChallengeCategory
  createdAt   DateTime          @default(now())
  challenge   Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId, dayNumber])
  @@index([challengeId, date])
}

model Reminder {
  id        String       @id @default(cuid())
  userId    String
  type      ReminderType
  timeOfDay String?
  isEnabled Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model CheckIn {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime      @db.Date
  period    CheckInPeriod
  energy    Int?
  focus     Int?
  mood      Int?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, period])
}

model Experiment {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  metrics     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CategoryGroup {
  STUDY
  WORK
  PHONE
  SLEEP
  HEALTH
  LIFE
  LEISURE
  OTHER
}

enum DistractionType {
  NONE
  PHONE
  YOUTUBE
  FRIENDS
  UNEXPECTED_WORK
  TIRED
  PROCRASTINATION
  OTHER
}

enum GoalType {
  GENERAL
  WAKE_UP
  SLEEP
  PHONE_FREE_FINAL_HOUR
}

enum ChallengeCategory {
  SKILL
  EXPERIENCE
  HEALTH
  SOCIAL
  CREATIVITY
  OTHER
}

enum ReminderType {
  WAKE_UP
  SLEEP
  PHONE_FREE_FINAL_HOUR
  DAILY_LOGGING
  GOAL_DEADLINE
  CHALLENGE
}

enum CheckInPeriod {
  MORNING
  AFTERNOON
  NIGHT
}
